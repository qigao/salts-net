schema Session [id(1), version(100), byte_order(little)];

[id(1), version(100)]
enum MessageType <uint8> {
    LoginRequest = 1;
    LoginResponse = 2;
    Heartbeat = 3;
}

[id(10)]
composite Header {
    uint8_t type;
    uint32_t seq_num;
    uint64_t timestamp;
}

[id(20), version(1)]
message LoginMessage {
    Header header;
    bytes(16) pass_hash;
    string username;
}

[id(30)]
message Heartbeat {
    Header header;
    uint32_t load;
}
