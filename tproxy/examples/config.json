{
  "listen_urls": "tcp://0.0.0.0:1080, tcp://0.0.0.0:8000-8005",
  "enable_socks5": true,
  "enable_http": true,
  "rate_limit_bps": 1048576,
  "whitelist_ips": "127.0.0.1, 192.168.1.100",
  "blacklist_ips": "8.8.8.8",
  "rules": [
    "DOMAIN,google.com,Proxy,wss://us-west.proxy:443",
    "DOMAIN-SUFFIX,cn,Direct",
    "DOMAIN-KEYWORD,twitter,Proxy,wss://hk.proxy:443",
    "IP-CIDR,10.0.0.0/8,Direct",
    "MATCH,Direct"
  ]
}
