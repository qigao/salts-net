{
  "version": 6,
  "include": [
    "ConfigurePresets.json"
  ],
  "buildPresets": [
    {
      "name": "default-windows",
      "displayName": "Build (Default, Windows)",
      "configurePreset": "dev-win-msvc-ninja",
      "inherits": [
        "ISWindows"
      ]
    },
    {
      "name": "asan-windows",
      "displayName": "Build with ASan (Windows)",
      "configurePreset": "dev-win-msvc-ninja-asan",
      "inherits": [
        "ISWindows"
      ]
    },
    {
      "name": "release-windows",
      "displayName": "Build (Release, Windows)",
      "configurePreset": "release-win-msvc-ninja",
      "inherits": [
        "ISWindows"
      ]
    },
    {
      "name": "default-linux",
      "displayName": "Build (Default, Linux)",
      "configurePreset": "release-linux-ninja",
      "inherits": [
        "ISLinux"
      ]
    },
    {
      "name": "debug-linux",
      "displayName": "Build Debug (Linux)",
      "configurePreset": "dev-linux-ninja",
      "inherits": [
        "ISLinux"
      ]
    },
    {
      "name": "default-mac",
      "displayName": "Build (Default, Mac)",
      "configurePreset": "release-mac-ninja",
      "inherits": [
        "ISMac"
      ]
    }
  ]
}