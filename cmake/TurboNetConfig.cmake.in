@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(Threads)
 
find_dependency(Rocida CONFIG REQUIRED
                PATHS "$ENV{ROCIDA_ROOT}"
                NO_DEFAULT_PATH)
find_dependency(TurboParser CONFIG REQUIRED
                PATHS "$ENV{TURBOPARSER_ROOT}"
                NO_DEFAULT_PATH)

include("${CMAKE_CURRENT_LIST_DIR}/TurboNetTargets.cmake")

check_required_components(TurboNet)
