{
    "version": 6,
    "include": [
        "CMakePresets.json"
    ],
    "configurePresets": [
        {
            "name": "win-paths",
            "hidden": true,
            "cacheVariables": {
                "EXTERNAL_REPO_ROOT": "c:/projects/cpp/external/",
                "EXTERNAL_ROOT": "c:/projects/cpp/external/pkgs",
                "CMAKE_MAKE_PROGRAM": "C:/Users/lockg/scoop/shims/ninja.exe",
                "VCPKG_TARGET_TRIPLET": "x64-windows"
            },
            "environment": {
                "VCPKG_ROOT": "C:/tools/vcpkg"
            }
        },
        {
            "name": "linux-paths",
            "hidden": true,
            "cacheVariables": {
              "VCPKG_TARGET_TRIPLET": "x64-linux",
              "CMAKE_MAKE_PROGRAM": "/usr/bin/ninja"
            },
            "environment": {
              "VCPKG_ROOT": "/vcpkg"
            }
        },
        {
            "name": "win-dev-user",
            "displayName": "Developer Build (Windows, User)",
            "inherits": [
                "dev-win-msvc-ninja",
                "win-paths",
                "pkg-vcpkg"
            ]
        },
        {
            "name": "win-release-user",
            "displayName": "Release Build (Windows, User)",
            "inherits": [
                "release-win-msvc-ninja",
                "win-paths",
                "pkg-vcpkg"
            ]
        },
        {
            "name": "win-dev-user-ASan",
            "displayName": "Developer Build (Windows, ASAN,User)",
            "inherits": [
                "dev-win-msvc-ninja-asan",
                "win-paths",
                "pkg-vcpkg"
            ]
        },
        {
            "name": "linux-dev-user",
            "displayName": "Developer Build (Linux, User)",
            "inherits": [
              "dev-linux-ninja",
              "linux-paths",
              "pkg-vcpkg"
            ]
        },
        {
            "name": "linux-container",
            "displayName": "Linux Container Build",
            "inherits": [
              "release-linux-ninja",
              "linux-paths",
              "pkg-vcpkg"
            ]
        },
        {
            "name": "linux-debug-container",
            "displayName": "Linux Container Debug Build",
            "inherits": [
              "dev-linux-ninja",
              "linux-paths",
              "pkg-vcpkg"
            ]
        }
    ]
}
