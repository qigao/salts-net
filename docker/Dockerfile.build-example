ARG SALTS_SDK_IMAGE=salts-sdk:bookworm
FROM ${SALTS_SDK_IMAGE}

RUN test -f /opt/salts/release/lib/cmake/Salts/SaltsConfig.cmake

WORKDIR /workspace

COPY vcpkg.json ./
RUN vcpkg install --triplet x64-linux

COPY . ./

RUN cmake -S . -B build/docker -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_TOOLCHAIN_FILE="$VCPKG_ROOT/scripts/buildsystems/vcpkg.cmake" \
    -DVCPKG_TARGET_TRIPLET=x64-linux \
    -DVCPKG_MANIFEST_MODE=OFF \
    -DVCPKG_INSTALLED_DIR=/workspace/vcpkg_installed \
    -DBUILD_TESTING=OFF \
    -DBUILD_EXAMPLES=OFF \
    && cmake --build build/docker

# Optional:
# RUN ctest --preset linux-release-user
# RUN cmake --install build --prefix /usr/local
