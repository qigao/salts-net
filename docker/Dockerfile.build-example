ARG SALTS_SDK_IMAGE=salts-sdk:bookworm
FROM ${SALTS_SDK_IMAGE}

RUN test -f /opt/salts/release/lib/cmake/Salts/SaltsConfig.cmake

WORKDIR /workspace

COPY vcpkg.json ./
RUN vcpkg install --triplet x64-linux

COPY . ./

RUN cmake --preset linux-release-user \
    -DBUILD_TESTING=OFF \
    -DBUILD_EXAMPLES=OFF \
    && cmake --build --preset linux-release-user

# Optional:
# RUN ctest --preset linux-release-user
# RUN cmake --install build --prefix /usr/local
