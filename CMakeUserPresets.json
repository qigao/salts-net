{
    "version": 6,
    "include": [
        "CMakePresets.json"
    ],
    "configurePresets": [
        {
            "name": "win-toolchain",
            "hidden": true,
            "environment": {
                "PROJECT_ROOT": "C:/projects/cpp",
                "PKG_ROOT": "$env{PROJECT_ROOT}/external/pkgs",
                "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed",
                "VCPKG_ROOT": "C:/tools/vcpkg",
                "USER_ROOT": "C:/Users/lockg",
                "PROGRAM_FILES_X86_ROOT": "C:/Program Files (x86)",
                "WINDOWS_ROOT": "C:/Windows"
            }
        },
        {
            "name": "win-paths",
            "hidden": true,
            "inherits": "win-toolchain",
            "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
            "cacheVariables": {
                "VCPKG_INSTALLED_DIR": "$env{VCPKG_INSTALLED_DIR}",
                "PKG_CONFIG_EXECUTABLE": "$env{VCPKG_INSTALLED_DIR}/x64-windows/tools/pkgconf/pkgconf.exe",
                "VCPKG_TARGET_TRIPLET": "x64-windows",
                "VCPKG_MANIFEST_MODE": "ON"
            },
            "architecture": { "value": "x64", "strategy": "external" },
            "toolset": { "value": "host=x64", "strategy": "external" }
        },        
        {
            "name": "android-win-paths",
            "hidden": true, 
            "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
            "cacheVariables": {
                "PKG_CONFIG_EXECUTABLE": "${sourceDir}/vcpkg_installed/x64-windows/tools/pkgconf/pkgconf.exe",
                "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
                "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed"
            }
        },
        {
            "name": "linux-paths",
            "hidden": true,
            "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
            "cacheVariables": {
                "VCPKG_INSTALLED_DIR": "$env{VCPKG_INSTALLED_DIR}",
                "VCPKG_TARGET_TRIPLET": "x64-linux",
                "VCPKG_MANIFEST_MODE": "ON"
            },
            "environment": {
                "PKG_ROOT": "/opt",
                "VCPKG_ROOT": "/opt/vcpkg",
                "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed"
            }
        },
        {
            "name": "android-win-environment",
            "hidden": true,
            "inherits": "win-toolchain",
            "environment": {
                "ANDROID_SDK_ROOT": "$env{USER_ROOT}/AppData/Local/Android/Sdk",
                "ANDROID_NDK_VERSION": "28.2.13676358",
                "ANDROID_NDK_HOME": "$env{ANDROID_SDK_ROOT}/ndk/$env{ANDROID_NDK_VERSION}"
            }
        },
        {
            "name": "android-dependencies-debug",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/saltsnet-android/debug"
            },
            "environment": {
                "SALTS_ROOT": "$env{PKG_ROOT}/salts-android/debug"
            }
        },
        {
            "name": "android-dependencies-release",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/saltsnet-android/release"
            },
            "environment": {
                "SALTS_ROOT": "$env{PKG_ROOT}/salts-android/release"
            }
        },
        {
            "name": "win-dev-user",
            "cacheVariables": {
                "ENABLE_SANITIZER_ADDRESS": "ON",
                "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-windows/debug",
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/saltsnet/debug",
                "PERL_EXECUTABLE": "$env{USER_ROOT}/scoop/persist/vcpkg/downloads/tools/perl/5.38.0.1/perl/bin/perl.exe"
            },
            "environment": {
                "SALTS_ROOT": "$env{PKG_ROOT}/salts/debug",
                "PATH": "${sourceDir}/build/Msvc/bin${pathListSep}$env{SALTS_ROOT}/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-windows/debug/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-windows/bin${pathListSep}$penv{PATH}"
            },
            "inherits": ["base-win-dev-user", "win-paths"]
        },
        {
            "name": "win-release-user",
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-windows",
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/saltsnet/release",
                "PERL_EXECUTABLE": "$env{USER_ROOT}/scoop/persist/vcpkg/downloads/tools/perl/5.38.0.1/perl/bin/perl.exe"
            },
            "environment": {
                "SALTS_ROOT": "$env{PKG_ROOT}/salts/release",
                "PATH": "${sourceDir}/build/Msvc-Release/bin${pathListSep}$env{SALTS_ROOT}/bin${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-windows/bin${pathListSep}$penv{PATH}"
            },
            "inherits": ["base-win-release-user", "win-paths"]
        },
        {
            "name": "linux-dev-user",
            "cacheVariables": {
                "ENABLE_SANITIZER_ADDRESS": "ON",
                "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-linux/debug",
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/saltsnet/debug"
            },
            "environment": {
                "SALTS_ROOT": "$env{PKG_ROOT}/salts/debug",
                "LD_LIBRARY_PATH": "${sourceDir}/build/linux-gcc-debug/bin${pathListSep}$env{SALTS_ROOT}/lib${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-linux/debug/lib${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-linux/lib${pathListSep}$penv{LD_LIBRARY_PATH}"
            },
            "inherits": ["base-linux-dev-user", "linux-paths"]
        },
        {
            "name": "linux-release-user",
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-linux",
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/saltsnet/release"
            },
            "environment": {
                "SALTS_ROOT": "$env{PKG_ROOT}/salts/release",
                "LD_LIBRARY_PATH": "${sourceDir}/build/linux-gcc-release/bin${pathListSep}$env{SALTS_ROOT}/lib${pathListSep}$env{VCPKG_INSTALLED_DIR}/x64-linux/lib${pathListSep}$penv{LD_LIBRARY_PATH}"
            },
            "inherits": ["release-linux-ninja", "linux-paths"]
        },
        {
            "name": "linux-sdk-package",
            "binaryDir": "${sourceDir}/build/linux-gcc-sdk-package",
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": "$env{VCPKG_INSTALLED_DIR}/x64-linux",
                "CMAKE_INSTALL_PREFIX": "$env{PKG_ROOT}/saltsnet/release",
                "ENABLE_SANITIZER_ADDRESS": "OFF",
                "ENABLE_TESTS": "OFF",
                "BUILD_TESTS": "OFF",
                "BUILD_EXAMPLES": "OFF"
            },
            "environment": {
                "SALTS_ROOT": "$env{PKG_ROOT}/salts/release"
            },
            "inherits": ["release-linux-ninja", "linux-paths"]
        },
        { "name": "android-arm64-v8a-debug-win", "environment": { "ANDROID_BUILD_VARIANT": "android-arm64-v8a-debug" }, "inherits": ["android-arm64-v8a-debug", "android-win-paths", "android-win-environment", "android-dependencies-debug"] },
        { "name": "android-arm64-v8a-release-win", "environment": { "ANDROID_BUILD_VARIANT": "android-arm64-v8a-release" }, "inherits": ["android-arm64-v8a-release", "android-win-paths", "android-win-environment", "android-dependencies-release"] },
        { "name": "android-x86_64-debug-win", "environment": { "ANDROID_BUILD_VARIANT": "android-x86_64-debug" }, "inherits": ["android-x86_64-debug", "android-win-paths", "android-win-environment", "android-dependencies-debug"] },
        { "name": "android-x86_64-release-win", "environment": { "ANDROID_BUILD_VARIANT": "android-x86_64-release" }, "inherits": ["android-x86_64-release", "android-win-paths", "android-win-environment", "android-dependencies-release"] },
        { "name": "android-x86-debug-win", "environment": { "ANDROID_BUILD_VARIANT": "android-x86-debug" }, "inherits": ["android-x86-debug", "android-win-paths", "android-win-environment", "android-dependencies-debug"] },
        { "name": "android-x86-release-win", "environment": { "ANDROID_BUILD_VARIANT": "android-x86-release" }, "inherits": ["android-x86-release", "android-win-paths", "android-win-environment", "android-dependencies-release"] }
    ],
    "buildPresets": [
        { "name": "win-dev-user", "configurePreset": "win-dev-user" },
        { "name": "win-release-user", "configurePreset": "win-release-user" },
        { "name": "linux-dev-user", "configurePreset": "linux-dev-user" },
        { "name": "linux-release-user", "configurePreset": "linux-release-user" },
        { "name": "linux-sdk-package", "configurePreset": "linux-sdk-package" },
        { "name": "install-win-dev-user", "configurePreset": "win-dev-user", "targets": ["install"] },
        { "name": "install-win-release-user", "configurePreset": "win-release-user", "targets": ["install"] },
        { "name": "install-linux-dev-user", "configurePreset": "linux-dev-user", "targets": ["install"] },
        { "name": "install-linux-release-user", "configurePreset": "linux-release-user", "targets": ["install"] },
        { "name": "android-arm64-v8a-debug-win", "configurePreset": "android-arm64-v8a-debug-win" },
        { "name": "android-arm64-v8a-release-win", "configurePreset": "android-arm64-v8a-release-win" },
        { "name": "android-x86_64-debug-win", "configurePreset": "android-x86_64-debug-win" },
        { "name": "android-x86_64-release-win", "configurePreset": "android-x86_64-release-win" },
        { "name": "android-x86-debug-win", "configurePreset": "android-x86-debug-win" },
        { "name": "android-x86-release-win", "configurePreset": "android-x86-release-win" },
        { "name": "install-android-arm64-v8a-debug-win", "configurePreset": "android-arm64-v8a-debug-win", "targets": ["install"] },
        { "name": "install-android-arm64-v8a-release-win", "configurePreset": "android-arm64-v8a-release-win", "targets": ["install"] },
        { "name": "install-android-x86_64-debug-win", "configurePreset": "android-x86_64-debug-win", "targets": ["install"] },
        { "name": "install-android-x86_64-release-win", "configurePreset": "android-x86_64-release-win", "targets": ["install"] },
        { "name": "install-android-x86-debug-win", "configurePreset": "android-x86-debug-win", "targets": ["install"] },
        { "name": "install-android-x86-release-win", "configurePreset": "android-x86-release-win", "targets": ["install"] }
    ],
    "testPresets": [
        { "name": "win-dev-user", "inherits": "base-test", "configurePreset": "win-dev-user" },
        { "name": "win-release-user", "inherits": "base-test", "configurePreset": "win-release-user" },
        { "name": "linux-dev-user", "inherits": "base-test", "configurePreset": "linux-dev-user" },
        { "name": "linux-release-user", "inherits": "base-test", "configurePreset": "linux-release-user" }
    ]
}
