ARG SALTS_SDK_IMAGE=salts-sdk:bookworm
FROM ${SALTS_SDK_IMAGE}

RUN test -f /opt/salts/release/lib/cmake/Salts/SaltsConfig.cmake

ENV CMAKE_PREFIX_PATH=/opt/saltsnet/release
ENV LD_LIBRARY_PATH=/opt/saltsnet/release/lib

WORKDIR /src/saltsnet

COPY . ./

RUN cmake --preset linux-sdk-package \
    && cmake --build --preset linux-sdk-package --target install
