{
  "security": {
    "max_request_size": 2097152,
    "max_header_size": 16384,
    "max_url_length": 4096,
    "max_headers_count": 50
  },
  "rate_limits": {
    "requests_per_second": 500,
    "connections_per_ip": 50
  },
  "timeouts": {
    "connection_timeout": 60,
    "request_timeout": 120,
    "keepalive_timeout": 600
  },
  "memory": {
    "arena_initial_size": 8192,
    "arena_max_size": 2097152
  },
  "logging": {
    "log_level": "DEBUG",
    "log_format": "[{time}] [{level}] {message}"
  },
  "tls": {
    "cipher_suites": "ECDHE+AESGCM:ECDHE+CHACHA20:DHE+AESGCM:DHE+CHACHA20:!aNULL:!MD5:!DSS",
    "min_tls_version": "1.2"
  },
  "max_concurrent_connections": 5000,
  "worker_threads": 8,
  "enable_compression": true,
  "enable_health_check": true,
  "health_check_path": "/health",
  "enable_csrf_protection": true,
  "enable_xss_protection": true,
  "enable_content_security_policy": true,
  "max_file_upload_size": 20971520,
  "allowed_file_extensions": "jpg,jpeg,png,gif,pdf,txt,doc,docx,zip",
  "enable_cors": true,
  "cors_allowed_origins": "https://example.com,https://api.example.com",
  "cors_allowed_methods": "GET,POST,PUT,DELETE,OPTIONS,PATCH",
  "cors_allowed_headers": "Content-Type,Authorization,X-Requested-With",
  "read_buffer_size": 8192,
  "write_buffer_size": 8192,
  "tcp_nodelay": 1,
  "tcp_keepalive": 1
}