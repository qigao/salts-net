{{! RFL Type Declaration Template - Generates .rfl file for RulesForge }}
{{!
RulesForge supported types:
- Primitives: int, double, String
- Containers: List<T>, Set<T>, Map<K,V>
- Custom types: declared types
- Special: Number (for accumulate results)
}}

{{#schema}}
// Generated from {{schema_name}} schema
package {{schema_name}}

{{/schema}}
{{#composites}}
/**
 * @brief {{name}} composite type
 */
declare {{name}}
{{#fields}}
{{#is_numeric}}
    {{name}}: {{#is_float}}double{{/is_float}}{{^is_float}}int{{/is_float}}
{{/is_numeric}}
{{#is_bytes}}{{#is_fixed_size}}
    {{name}}: String  // bytes represented as String in RulesForge
{{/is_fixed_size}}{{/is_bytes}}
{{#is_enum_ref}}
    {{name}}: int  // enum {{enum_c_type}}
{{/is_enum_ref}}
{{#is_composite_ref}}
    {{name}}: {{type}}
{{/is_composite_ref}}
{{/fields}}
end

{{/composites}}
{{#messages}}
/**
 * @brief {{name}} message type
 */
declare {{name}}
{{#fields}}
{{#is_numeric}}
    {{name}}: {{#is_float}}double{{/is_float}}{{^is_float}}int{{/is_float}}
{{/is_numeric}}
{{#is_bytes}}{{#is_fixed_size}}
    {{name}}: String  // bytes represented as String in RulesForge
{{/is_fixed_size}}{{/is_bytes}}
{{#is_var_data}}
    {{name}}: String
{{/is_var_data}}
{{#is_composite_ref}}
    {{name}}: {{type}}
{{/is_composite_ref}}
{{#is_enum_ref}}
    {{name}}: int  // enum {{enum_c_type}}
{{/is_enum_ref}}
{{#is_group_field}}
    {{name}}: List<{{group_type}}>  // repeating group
{{/is_group_field}}
{{/fields}}
end

{{/messages}}
{{#enums}}
// Enum: {{enum_name}}
// Values: {{#items}}{{name}}={{value}}{{^last}}, {{/last}}{{/items}}
// Note: Use int type in declarations, values are: {{#items}}{{enum_name}}_{{name}}={{value}}{{^last}}, {{/last}}{{/items}}

{{/enums}}



